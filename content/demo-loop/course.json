      "predictionQuestion": "先猜一猜：现在的程序会让角色动几次？",
      "durationHint": "大约 5 分钟",
      "initialProgram": {
        "format": "codematekids.program",
        "formatVersion": 1,
        "target": {"language": "python", "version": "3.12"},
