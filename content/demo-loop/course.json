{
  "courseId": "demo-loop",
  "version": 1,
  "title": "让角色重复前进",
  "ageBand": "小学三年级及以上",
  "learningObjectives": [
    "能看出程序里重复出现的动作",
    "能用重复积木表达重复次数",
    "能检查角色实际走了几步"
  ],
  "prerequisites": ["按顺序执行动作"],
  "knowledgePoints": [
    {"id": "kp.sequence", "name": "顺序"},
    {"id": "kp.loop", "name": "循环"}
  ],
  "tasks": [
    {
      "taskId": "main",
      "type": "main",
      "title": "让角色走四步",
      "teaching": {"goalKind": "distance", "suggestedStepsPerMove": 1, "knowledgePointIds": ["kp.loop"]},
      "objective": "让角色累计走 4 步。试着把前进积木放在重复里，再运行看看。",
      "predictionQuestion": "搭好积木后，先猜一猜角色会前进几次。",
      "durationHint": "大约 5 分钟",
      "initialProgram": {
        "format": "codematekids.program",
        "formatVersion": 1,
        "target": {"language": "python", "version": "3.12"},
        "courseRef": {"courseId": "demo-loop", "version": 1, "taskId": "main"},
        "root": null,
        "metadata": {"createdAt": "2026-11-14T00:00:00Z", "updatedAt": "2026-11-14T00:00:00Z"}
      },
      "expectedBehavior": "舞台显示累计走了 4 步。练习用重复积木来执行前进动作。",
      "allowedBlockKinds": [
        "event.start",
        "control.repeat",
        "motion.move",
        "motion.turn",
        "look.say",
        "text.print",
        "value.number",
        "value.calc"
      ],
      "successCriteria": [
        {
          "code": "stage_reached_four",
          "description": "角色累计向前走了 4 步",
          "check": {"object": "stage", "field": "steps", "op": "eq", "value": 4}
        }
      ],
      "commonErrors": [
        {
          "errorPattern": "loop_count_mismatch",
          "linkedHintLevels": [1, 2, 3],
          "description": "重复次数与目标步数不一致"
        },
        {
          "errorPattern": "action_outside_loop",
          "linkedHintLevels": [1, 2],
          "description": "前进动作没有放进循环体"
        }
      ],
      "hintLadder": [
        {
          "level": 1,
          "action": "ask_question",
          "promptText": "目标里要往前走几步？先数一数相同动作出现了几次。",
          "executableNextStep": "数一数目标要走的步数"
        },
        {
          "level": 2,
          "action": "hint",
          "promptText": "每次向前走一步，想想重复多少次能走 4 步。",
          "executableNextStep": "改一改重复次数，运行后数一数"
        },
        {
          "level": 3,
          "action": "show_execution",
          "promptText": "运行后，结果会告诉你角色动了几次、共走了几步。",
          "executableNextStep": "运行一次，把实际步数和目标比一比"
        }
      ],
      "demoSolution": {
        "note": "示范解法，仅在需要时展示",
        "times": 4
      },
      "variantOf": null,
      "variantTaskId": "variant",
      "ageNote": "使用短句和可见角色反馈，每次只需改动一个数字。",
      "reviewStatus": "reviewed"
    },
