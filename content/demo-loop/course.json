        "root": {
          "blockId": "b-start-main",
          "kind": "event.start",
          "inputs": {},
          "body": [],
          "next": {
            "blockId": "b-repeat-main",
            "kind": "control.repeat",
            "inputs": {"times": 2},
            "body": [
              {
                "blockId": "b-move-main",
                "kind": "motion.move",
                "inputs": {"steps": 1},
                "body": [],
                "next": null
              }
            ],
            "next": null
          }
        },
        "metadata": {"createdAt": "2026-11-14T00:00:00Z", "updatedAt": "2026-11-14T00:00:00Z"}
      },
      "expectedBehavior": "舞台显示累计走了 4 步。练习用重复积木来执行前进动作。",
      "allowedBlockKinds": [
        "event.start",
        "control.repeat",
        "motion.move",
        "motion.turn",
        "look.say",
        "text.print",
        "value.number",
        "value.calc"
      ],
      "successCriteria": [
