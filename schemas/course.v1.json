{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://codematekids.local/schemas/course.v1.json",
  "title": "课程内容包 v1",
  "type": "object",
  "required": [
    "courseId",
    "version",
    "title",
    "ageBand",
    "learningObjectives",
    "prerequisites",
    "tasks",
    "reviewStatus",
    "contentVersion"
  ],
  "additionalProperties": false,
  "properties": {
    "courseId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
    "version": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1, "maxLength": 20},
    "ageBand": {"const": "小学三年级及以上"},
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "prerequisites": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "knowledgePoints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1}
        }
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/task"}
    },
    "transferTaskId": {"type": ["string", "null"]},
    "otherThemes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["themeId", "title", "status"],
        "additionalProperties": false,
        "properties": {
          "themeId": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["coming_soon", "available"]}
        }
      }
    },
    "reviewStatus": {"enum": ["draft", "reviewed"]},
    "contentVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
  },
  "$defs": {
    "criterion": {
      "type": "object",
      "required": ["code", "description", "check"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string"},
        "description": {"type": "string"},
        "check": {
          "type": "object",
          "required": ["object", "field", "op", "value"],
          "additionalProperties": false,
          "properties": {
            "object": {"const": "stage"},
            "field": {"enum": ["x", "y", "heading", "steps", "moves"]},
            "op": {"enum": ["eq", "ge", "le"]},
            "value": {"type": "number"}
          }
        }
      }
    },
    "executionCriterion": {
      "type": "object",
      "required": ["code", "description", "check"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 64},
        "description": {"type": "string", "minLength": 1, "maxLength": 160},
        "check": {
          "type": "object",
          "required": ["kind", "inside", "atSteps"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "motion.turn"},
            "inside": {"enum": ["control.if", "control.else"]},
            "atSteps": {"type": "integer", "minimum": 0},
            "only": {"type": "boolean"}
          }
        }
      }
    },
    "commonError": {
      "type": "object",
      "required": ["errorPattern", "linkedHintLevels", "description"],
      "additionalProperties": false,
      "properties": {
        "errorPattern": {"type": "string"},
        "linkedHintLevels": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "integer", "minimum": 1, "maximum": 3}
        },
        "description": {"type": "string"}
      }
    },
    "hintLevel": {
      "type": "object",
      "required": ["level", "action", "promptText", "executableNextStep"],
      "additionalProperties": false,
      "properties": {
        "level": {"enum": [1, 2, 3]},
        "action": {
          "enum": [
            "ask_question",
            "hint",
            "point_to_block",
            "show_execution",
            "analogy",
            "partial_example",
            "break_down",
            "explain",
            "offer_variant"
          ]
        },
        "promptText": {"type": "string", "maxLength": 120},
        "executableNextStep": {"type": "string"}
      }
    },
    "task": {
      "type": "object",
      "required": [
        "taskId",
        "type",
        "title",
        "objective",
        "predictionQuestion",
        "initialProgram",
        "expectedBehavior",
        "allowedBlockKinds",
        "successCriteria",
        "commonErrors",
        "hintLadder",
        "ageNote",
        "reviewStatus"
      ],
      "additionalProperties": false,
      "properties": {
        "taskId": {"type": "string", "pattern": "^[A-Za-z0-9_-]{1,64}$"},
        "type": {"enum": ["main", "variant"]},
        "title": {"type": "string"},
        "objective": {"type": "string"},
        "predictionQuestion": {"type": "string"},
        "durationHint": {"type": "string"},
        "initialProgram": {"type": "object"},
        "expectedBehavior": {"type": "string"},
        "allowedBlockKinds": {
          "type": "array",
          "items": {"type": "string"}
        },
        "successCriteria": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/criterion"}
        },
        "executionCriteria": {
          "type": "array",
          "items": {"$ref": "#/$defs/executionCriterion"}
        },
        "commonErrors": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/commonError"}
        },
        "hintLadder": {
          "type": "array",
          "minItems": 3,
          "items": {"$ref": "#/$defs/hintLevel"}
        },
        "demoSolution": {"type": "object"},
        "variantOf": {"type": ["string", "null"]},
        "variantTaskId": {"type": ["string", "null"]},
        "nextTaskId": {"type": ["string", "null"]},
        "teaching": {
          "type": "object",
          "required": ["goalKind"],
          "additionalProperties": false,
          "properties": {
            "goalKind": {"enum": ["distance", "square", "route"]},
            "suggestedStepsPerMove": {"type": "integer", "minimum": 1, "maximum": 100},
            "knowledgePointIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "badge": {"type": "string", "minLength": 1, "maxLength": 24},
            "goalLabel": {"type": "string", "minLength": 1, "maxLength": 24},
            "stageView": {"enum": ["track", "path"], "deprecated": true, "description": "已停用：所有任务都用二维舞台。旧课包里的这个字段会被忽略。"},
            "useHintLadder": {"type": "boolean"},
            "stageGoal": {
              "type": "object",
              "required": ["scene", "route"],
              "additionalProperties": false,
              "properties": {
                "scene": {"enum": ["grid", "road", "beach"]},
                "route": {
                  "type": "array",
                  "minItems": 2,
                  "maxItems": 20,
                  "items": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {"type": "integer", "minimum": -20, "maximum": 20}
                  }
                }
              }
            },
            "feedback": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "success": {"type": "string", "minLength": 1, "maxLength": 160},
                "retry": {"type": "string", "minLength": 1, "maxLength": 160},
                "structureMissed": {"type": "string", "minLength": 1, "maxLength": 160}
              }
            }
          }
        },
        "programCriteria": {
          "type": "array",
          "items": {"enum": ["square_single_repeat"]}
        },
        "ageNote": {"type": "string"},
        "reviewStatus": {"enum": ["draft", "reviewed"]}
      }
    }
  }
}
